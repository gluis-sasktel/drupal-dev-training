
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  
  "branchPrefix": "renovate/",
  "dependencyDashboard": true, 
  "enabledManagers": ["composer"],
  "stabilityDays": 5,
  "rangeStrategy": "bump",
  

"packageRules": [
    {
      "matchManagers": ["composer"],
      "matchPackagePatterns": ["^drupal\\/core($|-)", "^drupal\\/core-"],
      "groupName": "Drupal core",
      "labels": ["dependencies", "drupal-core"]
    },
    {
      "matchManagers": ["composer"],
      "matchPackagePatterns": ["^drupal\\/(?!core(?:$|-))"],
      "groupName": "Drupal contrib modules",
      "labels": ["dependencies", "drupal-contrib"]
    }
  ],

  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["at any time"]
  },
  "baseBranches": ["site-building-01"]
}
