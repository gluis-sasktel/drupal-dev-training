
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  
  "branchPrefix": "renovate/",
  "dependencyDashboard": true, 
  "enabledManagers": ["composer"],
  "stabilityDays": 5,
  "rangeStrategy": "bump",
  
"packageRules": [
    {
      "matchManagers": ["composer"],
      "matchPackagePatterns": ["^drupal/core($|-)", "^drupal/core-"],
      "groupName": "Drupal core"
    },
    {
      "matchManagers": ["composer"],
      "matchPackagePatterns": ["^drupal/(?!core)"],
      "groupName": "Drupal contrib modules"
    }
  ],

  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["at any time"]
  },
  "baseBranches": ["site-building-01"]
}
