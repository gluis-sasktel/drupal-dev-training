
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "platform": "github",
  "onboarding": false,
  "requireConfig": false,
  "branchPrefix": "renovate/",
  "repositories": ["gluis-sasktel/drupal-dev-training"], 
  "enabledManagers": ["composer", "npm"],
  "rangeStrategy": "bump",
  "labels": ["dependencies"],
  "dependencyDashboard": true,
  "packageRules": [
    {
      "matchManagers": ["composer"],
      "matchPackagePatterns": ["^drupal/"],
      "groupName": "Drupal core & modules",
      "stabilityDays": 1
    }
  ]

}
